# Set these in the Vercel project, not in a local file. There is no local dev here.
#
# The publishable key grants the `anon` role, which can read the `lead_list` view and
# nothing else: every base table keeps RLS enabled with no policies. It is never sent to
# the browser either, because every query runs in a server component.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The console's only write credential. It is not the service-role key: writes go through
# four named database functions that each check this value against a SHA-256 held in
# settings.console_write_token_sha256. Unset means writing is disabled and the contacts
# panel says so. Rotate by setting a new hash in the database and the new value here, in
# that order. Migration 0013 section 6 and 0014 have the reasoning.
CONSOLE_WRITE_TOKEN=

# Exa, for finding the talent lead at a company on demand. About $0.004 a search.
# Unset means the contacts panel offers the manual form only; nothing else breaks.
EXA_API_KEY=
